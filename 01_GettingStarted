# To Install floci
iwr https://floci.io/install.ps1 | iex

#To start
floci start

# To set AWS Env varibales
eval $(floci env)
# exports AWS_ENDPOINT_URL, AWS_ACCESS_KEY_ID,
# AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION

# To tells AWS CLI and compatible SDKs to send requests to your local Floci endpoint.
$env:AWS_ENDPOINT_URL = "http://localhost:4566"

# To verify Floci is responding
Invoke-RestMethod http://localhost:4566/_floci/health

# Check status
floci status

# View logs
floci logs --follow

# Stop the emulator
floci stop

# Run health diagnostics
floci doctor

# To see what environment variables Floci recommends
floci env

# Install AWS CLI on Windows
winget install --id Amazon.AWSCLI --exact

# to see version
aws --version

# Check status
floci status

# View logs
floci logs --follow

# Configure AWS CLI for Floci
$env:AWS_ENDPOINT_URL = "http://localhost:4566"
$env:AWS_ACCESS_KEY_ID = "test"
$env:AWS_SECRET_ACCESS_KEY = "test"
$env:AWS_DEFAULT_REGION = "us-east-1"

Task 1: create as s3 bucket
===========================
# create s3 bucket
aws s3 mb s3://my-bucket              /* here "my-bucket" is bucket name */
# Verify the bucket
aws s3 ls


Task 2: Create a file and upload it in s3 bucket and then download it
=====================================================================

# create a file 
echo "Why pay for s3 when floci is free?" > hello-floci.txt

# copy it to s3 bucket
 aws s3 cp .\hello-floci.txt s3://my-bucket/hello-floci.txt

# Verify the file was uploaded
aws s3 ls s3://my-bucket/

# Download file under different name
aws s3 cp s3://my-bucket/hello-floci.txt ./downloaded-hello-floci.txt

# To see content of file
 Get-content .\hello-floci.txt
